<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".SecondActivity">

    <Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:navigationIcon="@drawable/arrow_back"
        android:title="@string/article_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Рубрика прижата вправо -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:letterSpacing="0.2"
                android:text="@string/second_category"
                android:textColor="@color/mars"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Заголовок по центру, засечками -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/second_title"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/second_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="italic" />

            <ImageView
                android:id="@+id/article_image"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/second_image_caption"
                android:scaleType="centerCrop"
                tools:src="@drawable/image_placeholder" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="start"
                android:text="@string/second_image_caption"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="italic" />

            <!-- Лид: полужирный шрифт и увеличенный межстрочный интервал -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/second_lead"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <TextView
                style="@style/ArticleHeading"
                android:text="@string/second_heading_1" />

            <TextView
                style="@style/ArticleParagraph"
                android:text="@string/second_paragraph_1" />

            <!-- Цитата: цветная полоса слева + фон -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_quote"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="@color/mars" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:padding="12dp"
                    android:text="@string/second_quote"
                    android:textColor="@color/mars"
                    android:textSize="18sp"
                    android:textStyle="italic" />
            </LinearLayout>

            <TextView
                style="@style/ArticleHeading"
                android:text="@string/second_heading_2" />

            <TextView
                style="@style/ArticleParagraph"
                android:text="@string/second_paragraph_2" />

            <!-- Цифры статьи: три равные колонки -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout style="@style/ArticleStat">

                    <TextView
                        style="@style/ArticleStatValue"
                        android:text="@string/second_stat_1_value" />

                    <TextView
                        style="@style/ArticleStatLabel"
                        android:text="@string/second_stat_1_label" />
                </LinearLayout>

                <LinearLayout style="@style/ArticleStat">

                    <TextView
                        style="@style/ArticleStatValue"
                        android:text="@string/second_stat_2_value" />

                    <TextView
                        style="@style/ArticleStatLabel"
                        android:text="@string/second_stat_2_label" />
                </LinearLayout>

                <LinearLayout style="@style/ArticleStat">

                    <TextView
                        style="@style/ArticleStatValue"
                        android:text="@string/second_stat_3_value" />

                    <TextView
                        style="@style/ArticleStatLabel"
                        android:text="@string/second_stat_3_label" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/ArticleParagraph"
                android:text="@string/second_paragraph_3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:gravity="end"
                android:text="@string/second_signature"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Переключатель «Прочитано» -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_read_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mark_as_read"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mark_as_read_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/read_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/mark_as_read" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>
